/* STARZ BMS STM32F446ZE common board mapping. */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    chosen {
        zephyr,console = &usart3;
        zephyr,shell-uart = &usart3;
        zephyr,canbus = &can1;
    };

    bms_board_io: bms-board-io {
        compatible = "starz,bms-board-io";
        rs485-de-re-gpios = <&gpiob 2 GPIO_ACTIVE_HIGH>;
        buzzer-gpios = <&gpiod 15 GPIO_ACTIVE_HIGH>;
        start-gpios = <&gpiof 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    bms_leds: bms-leds {
        compatible = "gpio-leds";
        bms_led1: led_1 { gpios = <&gpioc 4 GPIO_ACTIVE_HIGH>; label = "BMS LED 1"; };
        bms_led2: led_2 { gpios = <&gpiof 12 GPIO_ACTIVE_HIGH>; label = "BMS LED 2"; };
        bms_led3: led_3 { gpios = <&gpioa 7 GPIO_ACTIVE_HIGH>; label = "BMS LED 3"; };
        bms_led4: led_4 { gpios = <&gpiof 13 GPIO_ACTIVE_HIGH>; label = "BMS LED 4"; };
    };

    bms_keys: bms-keys {
        compatible = "gpio-keys";
        sw1: switch_1 { gpios = <&gpioa 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; label = "BMS SW1"; zephyr,code = <INPUT_KEY_1>; };
        sw2: switch_2 { gpios = <&gpioa 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; label = "BMS SW2"; zephyr,code = <INPUT_KEY_2>; };
        sw3: switch_3 { gpios = <&gpioa 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; label = "BMS SW3"; zephyr,code = <INPUT_KEY_3>; };
        sw4: switch_4 { gpios = <&gpiof 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; label = "BMS SW4"; zephyr,code = <INPUT_KEY_4>; };
    };
};

/* Legacy CubeMX clock: 8 MHz crystal -> 168 MHz SYSCLK. */
&clk_hse {
    /delete-property/ hse-bypass;
    clock-frequency = <8000000>;
    status = "okay";
};

&pll {
    div-m = <4>;
    mul-n = <168>;
    div-p = <2>;
    div-q = <7>;
    clocks = <&clk_hse>;
    status = "okay";
};

&rcc {
    clocks = <&pll>;
    clock-frequency = <168000000>;
    ahb-prescaler = <1>;
    apb1-prescaler = <4>;
    apb2-prescaler = <2>;
};

&can1 {
    pinctrl-0 = <&can1_rx_pd0 &can1_tx_pd1>;
    pinctrl-names = "default";
    bitrate = <500000>;
    sample-point = <857>;
    status = "okay";
};

&uart4 {
    pinctrl-0 = <&uart4_tx_pc10 &uart4_rx_pc11>;
    pinctrl-names = "default";
    current-speed = <115200>;
    status = "okay";
};

&uart5 {
    pinctrl-0 = <&uart5_tx_pe8 &uart5_rx_pe7>;
    pinctrl-names = "default";
    current-speed = <115200>;
    status = "okay";
};

&usart3 {
    pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
    pinctrl-names = "default";
    current-speed = <115200>;
    status = "okay";
};

&i2c3 {
    pinctrl-0 = <&i2c3_scl_pa8 &i2c3_sda_pc9>;
    pinctrl-names = "default";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    status = "okay";
};

&iwdg {
    status = "okay";
};


/*
 * 32S STARZ reference architecture:
 *   - BQ0/bottom: direct I2C1, same ground as MCU.
 *   - BQ1/top: I2C2 passes through an ISO1640 isolated I2C barrier.
 *   - Each BQ keeps the default 7-bit address 0x08 because they are on separate
 *     STM32 I2C controllers. This deliberately avoids OTP address programming.
 */
&i2c1 {
    pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb9>;
    pinctrl-names = "default";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    status = "okay";

    bq0: bq76952@8 {
        compatible = "ti,bq76952";
        reg = <0x08>;
        alert-gpios = <&gpioc 5 GPIO_ACTIVE_HIGH>;
        rst-shut-gpios = <&gpiob 14 GPIO_ACTIVE_HIGH>;
        dfetoff-gpios = <&gpiob 6 GPIO_ACTIVE_HIGH>;
    };
};

&i2c2 {
    pinctrl-0 = <&i2c2_scl_pf1 &i2c2_sda_pf0>;
    pinctrl-names = "default";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    status = "okay";

    /* MCU-side I2C2 -> ISO1640 -> upper-group BQ76952. */
    bq1: bq76952@8 {
        compatible = "ti,bq76952";
        reg = <0x08>;

        /*
         * Reference 32S PCB assignment through isolated/level-shifted GPIO:
         *   PE12 <- TOP_ALERT
         *   PB0  -> TOP_RST_SHUT
         *   PB7  -> TOP_DFETOFF
         * These pins were free/unlabelled in the legacy 16S design and become
         * routing requirements for the new 32S PCB.
         */
        alert-gpios = <&gpioe 12 GPIO_ACTIVE_HIGH>;
        rst-shut-gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
        dfetoff-gpios = <&gpiob 7 GPIO_ACTIVE_HIGH>;
    };
};
